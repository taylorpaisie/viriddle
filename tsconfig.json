{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@game-app": [
        "src/main.tsx"
      ]
    }
  },
  "include": [
    "src",
    "scripts/validate-cases.ts",
    "scripts/generate-case-sql.ts",
    "tests"
  ]
}
