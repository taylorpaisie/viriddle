# Optional public build overrides. Defaults are in config/public-services.ts.
# Use VITE_PLAY_MODE=local to run the offline sample library.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Set /viriddle/ for GitHub Pages. Leave / for Sites.
VITE_BASE_PATH=/
# Optional, when Supabase anonymous CAPTCHA is enabled (Cloudflare Turnstile).
VITE_TURNSTILE_SITE_KEY=
# Never put service_role, database passwords, or Google secrets in VITE_ variables.
