{
  "name": "outbreak",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 0.0.0.0",
    "test": "npm run typecheck && npm run test:cases && npm run test:backend",
    "test:backend": "node scripts/validate-backend.mjs",
    "cases:sql": "node --experimental-strip-types scripts/generate-case-sql.ts",
