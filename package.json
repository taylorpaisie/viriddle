    "test:cases": "node --experimental-strip-types scripts/validate-cases.ts",
    "test:connected": "node scripts/check-connected-build.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
